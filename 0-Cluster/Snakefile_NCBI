from os.path import join

configfile: "config/config.yaml"

# get list of accession numbers from accession number file
with open(config["accessionNumFile"], 'r') as f:
    accession_num_file = f.read()
    ACCESSION_NUMBERS = accession_num_file.split()

# list of clusters made in clustering_cooccur_prevalences.Rmd
clusters_015 = {"Bilophila_wadsworthia__BilWads6",
"Desulfovibrio_piger__DslPige3",
"Desulfovibrio_sp._6_1_46AFAA__DsvSp231",
"Gordonibacter_pamelaeae__GrdPame5",
"uncultured_bacterium__EF645667"
}

rule all:
	input:
		# get reference file without dups from Mueller 2015
		"config/Anantharaman2018_dsrA_dsrB_noDups.faa",
		"config/Anantharaman2018_dsrA_dsrB_noEDups.faa",
		"config/Anantharaman2018_dsrA_dsrB_noDups.json",

		# download human gut metagenomic data from NCBI
		expand(join(config["repositoryDir"],"{accession_num}"), accession_num=ACCESSION_NUMBERS),
		expand(join(config["dumpDir"],"{accession_num}.fa"),accession_num=ACCESSION_NUMBERS),
		
		# run Prodigal 
		expand(join(config["prodigalGeneCoordDir"],"{accession_num}_geneCoord.out"), accession_num=ACCESSION_NUMBERS),
		expand(join(config["prodigalProteinSeqDir"], "{accession_num}.faa"), accession_num=ACCESSION_NUMBERS),
		# run HMMER search of dsrAB on human gut metagenomic data		
		expand(join(config["hmmOutDir"],"{accession_num}_dsrAB_bact.hmm.out"), accession_num=ACCESSION_NUMBERS),
		expand(join(config["domtblDir"],"{accession_num}_dsrAB_bact.domtblout"), accession_num=ACCESSION_NUMBERS),
		expand(join(config["hmmOutDir"],"{accession_num}_dsrAB_arch.hmm.out"), accession_num=ACCESSION_NUMBERS),
		expand(join(config["domtblDir"],"{accession_num}_dsrAB_arch.domtblout"), accession_num=ACCESSION_NUMBERS),
		expand(join(config["msaDir"],"sto/{accession_num}_dsrAB_bact.sto"), accession_num=ACCESSION_NUMBERS),
		expand(join(config["msaDir"],"sto/{accession_num}_dsrAB_arch.sto"), accession_num=ACCESSION_NUMBERS),
		# parse HMMER domain table
		expand(join(config["summaryDir"],"{accession_num}_dsrAB_bact_hits.csv"), accession_num=ACCESSION_NUMBERS),
		expand(join(config["summaryDir"],"{accession_num}_dsrAB_arch_hits.csv"), accession_num=ACCESSION_NUMBERS),
		# convert from stockholm to fasta
		expand(join(config["msaDir"],"faa/{accession_num}_dsrAB_bact.faa"), accession_num=ACCESSION_NUMBERS),
		expand(join(config["msaDir"],"faa/{accession_num}_dsrAB_arch.faa"), accession_num=ACCESSION_NUMBERS),
		# get compiled files (THIS IS WHERE YOU CAN START)
		join(config["summaryDir"],"compiled_dsrAB_bact_hits.csv"),
        join(config["summaryDir"],"compiled_dsrAB_arch_hits.csv"),
		join(config["summaryDir"],"compiled_dsrAB_bact_hits.faa"),
        join(config["summaryDir"],"compiled_dsrAB_arch_hits.faa"),

		# extract true assemblies from compiled csv/faa
		config["assembliesQueryIDs"],
		join(config["summaryDir"],"compiled_dsrAB_bact_hits_assemblies.csv"),
		join(config["summaryDir"],"compiled_dsrAB_arch_hits_assemblies.csv"),
		join(config["summaryDir"],"compiled_dsrAB_bact_hits_assemblies.faa"),
		join(config["summaryDir"],"compiled_dsrAB_arch_hits_assemblies.faa"),

		# bit filtering
		join(config["cleanHitsDir"],"compiled_dsrAB_bact_hits_scoreThreshold_assemblies.csv"),
		join(config["cleanHitsDir"],"compiled_dsrAB_arch_hits_scoreThreshold_assemblies.csv"),
		join(config["cleanHitsDir"],"compiled_dsrAB_bact_hits_scoreThreshold_assemblies.faa"),
		join(config["cleanHitsDir"],"compiled_dsrAB_arch_hits_scoreThreshold_assemblies.faa"),
		# compiling archaeal and bacterial hits
		join(config["cleanHitsDir"],"compiled_dsrAB_hits_scoreThreshold_assemblies.faa"),
		join(config["cleanHitsDir"],"compiled_dsrAB_hits_scoreThreshold_assemblies.csv"),
		# removing dups
		join(config["cleanHitsDir"], "compiled_dsrAB_hits_scoreThreshold_assemblies_noDups.faa"),
		join(config["cleanHitsDir"], "compiled_dsrAB_hits_scoreThreshold_assemblies_noDups.json"),
		join(config["cleanHitsDir"], "compiled_dsrAB_hits_scoreThreshold_assemblies_noEDups.faa"),
		# run MAFFT
		join(config["cleanHitsDir"],"compiled_dsrAB_scoreThreshold_assemblies_noDups_msa_withRef.faa"),
		join(config["cleanHitsDir"],"compiled_dsrAB_scoreThreshold_assemblies_noDups_msa_noRef.faa"),
		# trim gaps
		join(config["cleanHitsDir"],"compiled_dsrAB_scoreThreshold_assemblies_noDups_gapPercentageInfo.csv"),
		join(config["cleanHitsDir"],"compiled_dsrAB_scoreThreshold_assemblies_noDups_msa_noRef_trimmedGaps.faa"),
		# final MSA
		join(config["cleanHitsDir"], "compiled_dsrAB_scoreThreshold_assemblies_noDups_msa_withRef_trimmedGaps.faa"),

		# get model parameters (.Daigle2026)
		# there will also be a log and info file produced
		join(config["modelParamsDir"], f"RAxML_binaryModelParameters.{config['treeFileExtension']}"),
		join(config["modelParamsDir"], f"RAxML_result.{config['treeFileExtension']}"),
		# fragment insertion (.Daigle2026_no_2018_assemblies)
		join(config["raxmlOutputDir"], f"RAxML_info.{config['treeFileExtension_no_2018_assemblies']}"),
		join(config["raxmlOutputDir"], f"RAxML_classification.{config['treeFileExtension_no_2018_assemblies']}"),
		join(config["raxmlOutputDir"], f"RAxML_classificationLikelihoodWeights.{config['treeFileExtension_no_2018_assemblies']}"),
		join(config["raxmlOutputDir"], f"RAxML_entropy.{config['treeFileExtension_no_2018_assemblies']}"),
		join(config["raxmlOutputDir"], f"RAxML_labelledTree.{config['treeFileExtension_no_2018_assemblies']}"),
		join(config["raxmlOutputDir"], f"RAxML_originalLabelledTree.{config['treeFileExtension_no_2018_assemblies']}"),
		join(config["raxmlOutputDir"], f"RAxML_portableTree.{config['treeFileExtension_no_2018_assemblies']}.jplace")
		# remove bootstrap values
		join(config["raxmlOutputDir"],"RAxML_originalLabelledTree_noBootstrap_no_2018_assemblies.newick"),
		join(config["raxmlOutputDir"],"RAxML_labelledTree_noBootstrap_no_2018_assemblies.newick"),

		# find names of reference sequences from the 2018 database so they can be used as references instead of queries
		# this file is used as input for the rules in getTreeInfo.smk but has no bearing on results since these sequences
		# were not inserted into the tree
		"workflow/out/treeInfo/Anantharaman2018_queryIDs_inTree.txt",
		# calculate branch distances between hit sequences and reference sequences and get other tree info
		"workflow/out/treeInfo/queryDistanceInfo_no_2018_assemblies.csv",
		"workflow/out/treeInfo/queryDistanceInfo_no_2018_assemblies.json",		
		"workflow/out/treeInfo/closestRefInfo_allScoreThresholdHits_no_2018_assemblies.csv",
		"workflow/out/treeInfo/closestRefList_no_2018_assemblies.txt",
  
   		# make taxa table
    	"workflow/out/clustering_test/taxa_table_0420.csv",

		# run blast on clusters to find ANI
		expand(join(config["clusterSeqsDir"], "{cluster}_cluster_seqs_015.fasta"), cluster=clusters_015),
		expand(join(config["clusterBlastDB"],"{cluster}_db_nuc_015.ndb"), cluster=clusters_015),
		expand(join(config["clusterBlastDB"],"{cluster}_db_nuc_015.nhr"), cluster=clusters_015),
		expand(join(config["clusterBlastDB"],"{cluster}_db_nuc_015.nin"), cluster=clusters_015),
		expand(join(config["clusterBlastDB"],"{cluster}_db_nuc_015.njs"), cluster=clusters_015),
		expand(join(config["clusterBlastDB"],"{cluster}_db_nuc_015.not"), cluster=clusters_015),
		expand(join(config["clusterBlastDB"],"{cluster}_db_nuc_015.nsq"), cluster=clusters_015),
		expand(join(config["clusterBlastDB"],"{cluster}_db_nuc_015.ntf"), cluster=clusters_015),
		expand(join(config["clusterBlastDB"],"{cluster}_db_nuc_015.nto"), cluster=clusters_015),
		expand(join(config["clusterBlastOutput"],"{cluster}_cluster_blast_015.out"), cluster=clusters_015),
		expand(join(config["clusterANI"],"{cluster}_clusterANI_015.csv"), cluster=clusters_015)

include: "workflow/rules/prepAnantharaman.smk"
include: "workflow/rules/downloadMetagenomicData.smk"
include: "workflow/rules/runHMMER.smk"
include: "workflow/rules/extractAssemblies.smk"
include: "workflow/rules/cleanHits.smk"
include: "workflow/rules/fragmentInsertion.smk"
include: "workflow/rules/getTreeInfo.smk"
include: "workflow/rules/makeTaxaTable.smk"
include: "workflow/rules/ANI_for_clusters.smk"
